# Copy to .env (never commit .env), then generate the two secrets with:
#   python3 -c "import secrets,base64,os;print('APEX_JWT_SECRET='+secrets.token_urlsafe(48));print('APEX_MASTER_KEY='+base64.b64encode(os.urandom(32)).decode())"
# Keep APEX_MASTER_KEY safe and backed up: without it, stored broker credentials cannot be decrypted.
APEX_ENVIRONMENT=dev
APEX_DB_PASSWORD=change-me
APEX_JWT_SECRET=
APEX_MASTER_KEY=
APEX_PAPER_ACCOUNT_CURRENCY=EUR
APEX_PAPER_INITIAL_BALANCE=10000
# true behind HTTPS in production
APEX_COOKIE_SECURE=false
