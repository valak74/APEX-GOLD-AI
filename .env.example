# Copy to .env (never commit .env), then generate the two secrets with:
#   python3 -c "import secrets,base64,os;print('APEX_JWT_SECRET='+secrets.token_urlsafe(48));print('APEX_MASTER_KEY='+base64.b64encode(os.urandom(32)).decode())"
# Keep APEX_MASTER_KEY safe and backed up: without it, stored broker credentials cannot be decrypted.
APEX_ENVIRONMENT=dev
APEX_DB_PASSWORD=change-me
APEX_JWT_SECRET=
APEX_MASTER_KEY=
APEX_PAPER_ACCOUNT_CURRENCY=EUR
APEX_PAPER_INITIAL_BALANCE=10000
# true behind HTTPS in production
APEX_COOKIE_SECURE=false

# Live market data from your linked cTrader DEMO account.
# 1) docker compose exec api apex ctrader-setup      (prints the internal account id)
# 2) set the two lines below, then: docker compose up -d api
APEX_MARKET_DATA_SOURCE=none
APEX_CTRADER_BROKER_ACCOUNT_ID=

# Optional written AI analysis of opportunities (paid API calls; see docs/12-opportunities-and-ai.md)
APEX_LLM_ENABLED=false
ANTHROPIC_API_KEY=
# Fundamental data: free key from https://fred.stlouisfed.org/docs/api/api_key.html (CFTC COT needs none)
APEX_FRED_API_KEY=
